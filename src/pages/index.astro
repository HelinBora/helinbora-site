
---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const featuredPost = posts[0];
const latestPosts = posts.slice(1, 4);
---

<!doctype html>
<html lang="tr">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>

  <body>
    <Header />

    <main>
      <!-- HERO -->
      <section class="hero">
        <div class="hero-label">
          <span class="status-dot"></span>
          <span>BAĞIMSIZ TEKNOLOJİ NOTLARI</span>
          <span class="hero-index">NO. 001 — 2026</span>
        </div>

        <h1>
          Teknolojiyi<br />
          <span>anlamak,</span><br />
          geleceği okumak.
        </h1>

        <div class="hero-bottom">
          <p>
            Yapay zekâ, yazılım ve teknoloji üzerine araştırmalar,
            düşünceler ve öğrenme notları.
          </p>

          <a href="/blog/" class="text-link">
            Yazıları keşfet
          </a>
        </div>
      </section>

      <!-- TOPICS -->
      <section class="topics section-block">
        <div class="section-heading">
          <span class="section-number">01 /</span>
          <h2>İlgi alanları</h2>
        </div>

        <div class="topic-grid">
          <a href="/blog/" class="topic">
            <span class="topic-number">01</span>
            <div>
              <h3>Yapay Zekâ</h3>
              <p>Modeller, algoritmalar ve yeni gelişmeler.</p>
            </div>
          </a>

          <a href="/blog/" class="topic">
            <span class="topic-number">02</span>
            <div>
              <h3>Yazılım</h3>
              <p>Mühendislik, geliştirme ve teknik notlar.</p>
            </div>
          </a>

          <a href="/blog/" class="topic">
            <span class="topic-number">03</span>
            <div>
              <h3>Teknoloji</h3>
              <p>Dijital dünyanın geçmişi ve geleceği.</p>
            </div>
          </a>
        </div>
      </section>

      <!-- FEATURED POST -->
      {featuredPost && (
        <section class="featured section-block">
          <div class="section-heading">
            <span class="section-number">02 /</span>
            <h2>Öne çıkan yazı</h2>
          </div>

          <a href={`/blog/${featuredPost.id}/`} class="featured-card">
            <div class="featured-meta">
              <span>SON YAYIN</span>
              <span>
                <FormattedDate date={featuredPost.data.pubDate} />
              </span>
            </div>

            <div class="featured-content">
              <div>
                <span class="featured-kicker">OKUMAYA BAŞLA</span>
                <h3>{featuredPost.data.title}</h3>
                <p>{featuredPost.data.description}</p>
              </div>
            </div>
          </a>
        </section>
      )}

      <!-- LATEST POSTS -->
      {latestPosts.length > 0 && (
        <section class="latest section-block">
          <div class="section-heading">
            <span class="section-number">03 /</span>
            <h2>Son yazılar</h2>
            <a href="/blog/" class="all-posts">Tüm yazılar</a>
          </div>

          <div class="latest-list">
            {latestPosts.map((post, index) => (
              <a href={`/blog/${post.id}/`} class="latest-item">
                <span class="latest-number">
                  {String(index + 1).padStart(2, '0')}
                </span>

                <div class="latest-info">
                  <h3>{post.data.title}</h3>
                  <p>{post.data.description}</p>
                </div>

                <span class="latest-date">
                  <FormattedDate date={post.data.pubDate} />
                </span>
              </a>
            ))}
          </div>
        </section>
      )}

      <!-- ABOUT -->
      <section class="about-section section-block">
        <div class="about-label">
          <span class="section-number">04 /</span>
          <span>BU BLOG HAKKINDA</span>
        </div>

        <div class="about-content">
          <h2>
            Merak etmek,<br />
            araştırmak ve<br />
            <span>paylaşmak.</span>
          </h2>

          <div class="about-description">
            <p>
              Teknolojiyi anlamak, sorgulamak ve ardındaki düşünceyi
              keşfetmek üzerine notlar.
            </p>
            <a href="/about/" class="text-link">
              Hakkımda
            </a>
          </div>
        </div>
      </section>

      <!-- FOOTER NOTE -->
      <div class="end-note">
        <span>HELİN BORA</span>
        <span>MERAKLA ÜRETİLDİ. ÖZENLE PAYLAŞILDI.</span>
      </div>
    </main>

    <Footer />
  </body>
</html>

<style>
  main {
    width: min(var(--content-width), calc(100% - 2 * var(--page-padding)));
    margin: 0 auto;
  }

  .hero {
    padding: 105px 0 90px;
    border-bottom: 1px solid var(--border);
  }

  .hero-label {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 42px;
    color: var(--text-secondary);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--black);
  }

  .hero-index {
    margin-left: auto;
    color: var(--text-muted);
  }

  .hero h1 {
    max-width: 950px;
    margin: 0;
    font-size: clamp(56px, 9vw, 112px);
    font-weight: 600;
    letter-spacing: -0.085em;
    line-height: 0.99;
  }

  .hero h1 span {
    color: #999999;
  }

  .hero-bottom {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 30px;
    margin-top: 52px;
  }

  .hero-bottom p {
    max-width: 390px;
    margin: 0;
    font-size: 16px;
    line-height: 1.8;
  }

  .text-link,
  .all-posts {
    display: inline-flex;
    align-items: center;
    padding-bottom: 5px;
    border-bottom: 1px solid var(--black);
    color: var(--black);
    font-size: 13px;
    font-weight: 700;
  }

  .section-block {
    padding: 76px 0;
    border-bottom: 1px solid var(--border);
  }

  .section-heading {
    display: flex;
    align-items: center;
    gap: 15px;
    margin-bottom: 35px;
  }

  .section-number {
    color: var(--text-muted);
    font-family: var(--font-heading);
    font-size: 12px;
    font-weight: 600;
  }

  .section-heading h2 {
    margin: 0;
    font-size: 22px;
    letter-spacing: -0.04em;
  }

  .topic-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .topic {
    display: grid;
    grid-template-columns: 30px 1fr;
    align-items: start;
    gap: 12px;
    min-height: 155px;
    padding: 25px 20px 25px 0;
    transition: background var(--transition);
  }

  .topic + .topic {
    padding-left: 22px;
    border-left: 1px solid var(--border);
  }

  .topic-number {
    color: var(--text-muted);
    font-size: 11px;
  }

  .topic h3 {
    margin: 0 0 10px;
    font-size: 20px;
  }

  .topic p {
    margin: 0;
    font-size: 13px;
    line-height: 1.7;
  }

  .featured-card {
    display: block;
    padding: 28px 32px 34px;
    background: var(--surface-dark);
    color: var(--white);
    transition: background var(--transition);
  }

  .featured-card:hover {
    background: #292929;
    color: var(--white);
  }

  .featured-meta {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    padding-bottom: 24px;
    border-bottom: 1px solid #3c3c3c;
    color: #aaaaaa;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .featured-content {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 30px;
    padding-top: 36px;
  }

  .featured-kicker {
    color: #999999;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  .featured-content h3 {
    max-width: 720px;
    margin: 15px 0;
    color: var(--white);
    font-size: clamp(30px, 5vw, 54px);
    letter-spacing: -0.06em;
  }

  .featured-content p {
    max-width: 550px;
    margin: 0;
    color: #bdbdbd;
    font-size: 14px;
  }

  .latest .section-heading {
    align-items: center;
  }

  .all-posts {
    margin-left: auto;
    border: 0;
    font-size: 12px;
  }

  .latest-list {
    border-top: 1px solid var(--border);
  }

  .latest-item {
    display: grid;
    grid-template-columns: 45px 1fr auto;
    align-items: center;
    gap: 20px;
    padding: 25px 0;
    border-bottom: 1px solid var(--border);
  }

  .latest-number,
  .latest-date {
    color: var(--text-muted);
    font-size: 12px;
  }

  .latest-info h3 {
    margin: 0 0 5px;
    font-size: 19px;
  }

  .latest-info p {
    margin: 0;
    font-size: 13px;
  }

  .about-section {
    padding: 80px 0 90px;
  }

  .about-label {
    display: flex;
    gap: 15px;
    align-items: center;
    color: var(--text-secondary);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .about-content {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    align-items: end;
    gap: 60px;
    margin-top: 45px;
  }

  .about-content h2 {
    margin: 0;
    font-size: clamp(45px, 7vw, 78px);
    letter-spacing: -0.075em;
    line-height: 1.02;
  }

  .about-content h2 span {
    color: #999999;
  }

  .about-description p {
    margin: 0 0 25px;
    font-size: 14px;
    line-height: 1.9;
  }

  .end-note {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    padding: 25px 0 35px;
    color: var(--text-muted);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  @media (max-width: 768px) {
    .hero {
      padding: 75px 0 65px;
    }

    .hero-label {
      flex-wrap: wrap;
      margin-bottom: 32px;
      font-size: 9px;
    }

    .hero h1 {
      font-size: clamp(49px, 12vw, 76px);
    }

    .hero-bottom {
      align-items: flex-start;
      flex-direction: column;
      margin-top: 35px;
    }

    .section-block {
      padding: 55px 0;
    }

    .topic-grid {
      grid-template-columns: 1fr;
    }

    .topic,
    .topic + .topic {
      min-height: auto;
      padding: 22px 0;
      border-left: 0;
    }

    .topic + .topic {
      border-top: 1px solid var(--border);
    }

    .featured-card {
      padding: 23px 20px 28px;
    }

    .featured-content {
      align-items: flex-start;
    }

    .latest-item {
      grid-template-columns: 30px 1fr;
      gap: 12px;
    }

    .latest-date {
      display: none;
    }

    .latest-info h3 {
      font-size: 16px;
    }

    .latest-info p {
      font-size: 12px;
    }

    .about-content {
      grid-template-columns: 1fr;
      gap: 30px;
      margin-top: 35px;
    }

    .about-content h2 {
      font-size: clamp(45px, 11vw, 65px);
    }

    .end-note {
      flex-direction: column;
      gap: 8px;
    }
  }

  @media (max-width: 420px) {
    .hero-index {
      width: 100%;
      margin-left: 19px;
    }

    .section-heading {
      gap: 10px;
    }

    .section-heading h2 {
      font-size: 19px;
    }

    .featured-meta {
      font-size: 9px;
    }
  }
</style>
