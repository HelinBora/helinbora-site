
---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="tr">
  <head>
    <BaseHead title={`Yazılar | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
  </head>

  <body>
    <Header />

    <main>
      <section class="blog-page">
        <div class="page-intro">
          <div class="page-label">
            <span class="section-number">01 /</span>
            <span>ARAŞTIRMALAR & NOTLAR</span>
          </div>

          <h1>Yazılar<span>.</span></h1>

          <p>
            Yapay zekâ, yazılım ve teknoloji üzerine düşünceler,
            araştırmalar ve öğrenme notları.
          </p>
        </div>

        <div class="post-list">
          {posts.length > 0 ? (
            posts.map((post, index) => (
              <article class:list={['post-item', { 'featured-post': index === 0 }]}>
                <a href={`/blog/${post.id}/`} class="post-link">
                  <div class="post-number">
                    {String(index + 1).padStart(2, '0')}
                  </div>

                  <div class="post-content">
                    <div class="post-meta">
                      <span>{index === 0 ? 'SON YAYIN' : 'YAZI'}</span>
                      <span>
                        <FormattedDate date={post.data.pubDate} />
                      </span>
                    </div>

                    <h2>{post.data.title}</h2>

                    <p class="post-description">{post.data.description}</p>

                    <span class="read-link">Yazıyı oku ↗</span>
                  </div>

                  {post.data.heroImage && (
                    <div class="post-image">
                      <Image
                        width={720}
                        height={360}
                        src={post.data.heroImage}
                        alt={post.data.title}
                      />
                    </div>
                  )}
                </a>
              </article>
            ))
          ) : (
            <div class="empty-state">
              <p>Henüz yayımlanmış bir yazı bulunmuyor.</p>
            </div>
          )}
        </div>

        <div class="page-end">
          <span>HELİN BORA</span>
          <span>MERAKLA ARAŞTIR, ÖĞREN VE PAYLAŞ.</span>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>

<style>
  main {
    width: min(var(--content-width), calc(100% - 2 * var(--page-padding)));
    margin: 0 auto;
  }

  .blog-page {
    padding-top: 90px;
  }

  .page-intro {
    padding-bottom: 55px;
    border-bottom: 1px solid var(--border);
  }

  .page-label {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 28px;
    color: var(--text-secondary);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .section-number {
    color: var(--text-muted);
    font-family: var(--font-heading);
  }

  .page-intro h1 {
    margin: 0;
    font-size: clamp(65px, 10vw, 100px);
    letter-spacing: -0.085em;
    line-height: 1;
  }

  .page-intro h1 span {
    color: #999999;
  }

  .page-intro > p {
    max-width: 450px;
    margin: 25px 0 0;
    font-size: 15px;
    line-height: 1.8;
  }

  .post-list {
    border-top: 1px solid var(--border);
  }

  .post-item {
    border-bottom: 1px solid var(--border);
  }

  .post-link {
    display: grid;
    grid-template-columns: 55px 1fr 220px;
    align-items: center;
    gap: 25px;
    padding: 35px 0;
  }

  .post-number {
    align-self: start;
    padding-top: 5px;
    color: var(--text-muted);
    font-family: var(--font-heading);
    font-size: 13px;
  }

  .post-meta {
    display: flex;
    gap: 18px;
    margin-bottom: 13px;
    color: var(--text-muted);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .post-content h2 {
    margin: 0 0 10px;
    font-size: 27px;
    letter-spacing: -0.055em;
    transition: color var(--transition);
  }

  .post-description {
    max-width: 530px;
    margin: 0;
    font-size: 13px;
    line-height: 1.7;
  }

  .read-link {
    display: inline-block;
    margin-top: 18px;
    color: var(--black);
    font-size: 11px;
    font-weight: 700;
  }

  .post-image {
    overflow: hidden;
    background: var(--surface);
    aspect-ratio: 16 / 9;
  }

  .post-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 250ms ease;
  }

  .post-link:hover .post-content h2 {
    color: var(--text-secondary);
  }

  .post-link:hover .post-image img {
    transform: scale(1.03);
  }

  .featured-post .post-content h2 {
    font-size: 32px;
  }

  .empty-state {
    padding: 55px 0;
    color: var(--text-secondary);
  }

  .page-end {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    padding: 28px 0 45px;
    color: var(--text-muted);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  @media (max-width: 720px) {
    .blog-page {
      padding-top: 65px;
    }

    .page-intro {
      padding-bottom: 40px;
    }

    .post-link {
      grid-template-columns: 30px 1fr;
      gap: 15px;
      padding: 27px 0;
    }

    .post-content h2,
    .featured-post .post-content h2 {
      font-size: 22px;
    }

    .post-image {
      grid-column: 2;
      width: 100%;
      max-width: 420px;
      margin-top: 5px;
    }

    .page-end {
      flex-direction: column;
      gap: 8px;
    }
  }
</style>
