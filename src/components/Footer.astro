
---
const today = new Date();
---

<footer>
  <div class="footer-inner">
    <div class="footer-top">
      <a href="/" class="footer-brand">helinbora<span>.</span></a>
      <a
        href="https://github.com/HelinBora"
        target="_blank"
        rel="noopener noreferrer"
        class="github-link"
        aria-label="GitHub profilim"
      >
        GitHub <span>↗</span>
      </a>
    </div>

    <div class="footer-bottom">
      <p>© {today.getFullYear()} Helin Bora. Tüm hakları saklıdır.</p>
      <span>Merakla araştır, öğren ve paylaş.</span>
    </div>
  </div>
</footer>

<style>
  footer {
    width: 100%;
    border-top: 1px solid var(--border);
    background: var(--background);
  }

  .footer-inner {
    width: min(var(--content-width), calc(100% - 2 * var(--page-padding)));
    margin: 0 auto;
  }

  .footer-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 28px 0;
  }

  .footer-brand {
    color: var(--black);
    font-family: var(--font-heading);
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.06em;
  }

  .footer-brand span {
    color: var(--text-muted);
  }

  .github-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--text-secondary);
    font-size: 12px;
    transition: color var(--transition);
  }

  .github-link:hover {
    color: var(--black);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    padding: 18px 0 25px;
    border-top: 1px solid var(--border);
  }

  .footer-bottom p,
  .footer-bottom span {
    margin: 0;
    color: var(--text-muted);
    font-size: 11px;
  }

  @media (max-width: 520px) {
    .footer-bottom {
      flex-direction: column;
      gap: 7px;
    }
  }
</style>
