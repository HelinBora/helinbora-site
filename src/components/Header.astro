
---
import HeaderLink from './HeaderLink.astro';
---

<header>
  <nav>
    <a href="/" class="brand">helinbora<span>.</span></a>

    <div class="internal-links">
      <HeaderLink href="/">Ana Sayfa</HeaderLink>
      <HeaderLink href="/blog/">Yazılar</HeaderLink>
      <HeaderLink href="/about/">Hakkımda</HeaderLink>
    </div>
  </nav>
</header>

<style>
  header {
    width: 100%;
    background: var(--background);
    border-bottom: 1px solid var(--border);
  }

  nav {
    width: min(var(--content-width), calc(100% - 2 * var(--page-padding)));
    min-height: 76px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 25px;
  }

  .brand {
    color: var(--black);
    font-family: var(--font-heading);
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.06em;
    text-decoration: none;
  }

  .brand span {
    color: var(--text-muted);
  }

  .internal-links {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .internal-links :global(a) {
    padding: 8px 0;
    color: var(--text-secondary);
    font-size: 13px;
    font-weight: 500;
    text-decoration: none;
    transition: color var(--transition);
  }

  .internal-links :global(a:hover),
  .internal-links :global(a.active) {
    color: var(--black);
  }

  @media (max-width: 520px) {
    nav {
      min-height: 68px;
      gap: 15px;
    }

    .brand {
      font-size: 16px;
    }

    .internal-links {
      gap: 14px;
    }

    .internal-links :global(a) {
      font-size: 11px;
    }
  }
</style>
