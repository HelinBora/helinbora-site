
---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<!doctype html>
<html lang="tr">
  <head>
    <BaseHead title={`${title} | Helin Bora`} description={description} />
  </head>

  <body>
    <Header />

    <main>
      <article>
        <header class="article-header">
          <div class="article-label">
            <span>YAZILAR</span>
            <span class="separator">/</span>
            <span>ARAŞTIRMA & NOTLAR</span>
          </div>

          <h1>{title}</h1>

          {description && <p class="article-description">{description}</p>}

          <div class="article-meta">
            <span><FormattedDate date={pubDate} /></span>

            {updatedDate && (
              <span class="last-updated">
                Son güncelleme: <FormattedDate date={updatedDate} />
              </span>
            )}
          </div>
        </header>

        {heroImage && (
          <div class="hero-image">
            <Image
              width={1200}
              height={600}
              src={heroImage}
              alt={title}
            />
          </div>
        )}

        <div class="prose">
          <slot />

          <div class="article-end">
            <span>—</span>
            <p>Okuduğun için teşekkürler.</p>
            <a href="/blog/">← Tüm yazılara dön</a>
          </div>
        </div>
      </article>
    </main>

    <Footer />
  </body>
</html>

<style>
  main {
    width: min(var(--content-width), calc(100% - 2 * var(--page-padding)));
    margin: 0 auto;
  }

  article {
    padding-top: 85px;
  }

  .article-header {
    max-width: 850px;
    margin: 0 auto;
    padding-bottom: 45px;
  }

  .article-label {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 30px;
    color: var(--text-muted);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.13em;
  }

  .separator {
    color: var(--border-strong);
  }

  .article-header h1 {
    margin: 0;
    font-size: clamp(38px, 6vw, 68px);
    font-weight: 600;
    letter-spacing: -0.07em;
    line-height: 1.08;
  }

  .article-description {
    max-width: 680px;
    margin: 25px 0 0;
    color: var(--text-secondary);
    font-size: 17px;
    line-height: 1.8;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    margin-top: 30px;
    padding-top: 20px;
    border-top: 1px solid var(--border);
    color: var(--text-muted);
    font-size: 12px;
  }

  .hero-image {
    width: 100%;
    margin: 0 auto 55px;
    overflow: hidden;
    background: var(--surface);
  }

  .hero-image img {
    display: block;
    width: 100%;
    max-height: 520px;
    object-fit: cover;
  }

  .prose {
    width: 100%;
    max-width: 720px;
    margin: 0 auto;
    padding-bottom: 75px;
    color: var(--text);
    font-size: 16px;
    line-height: 1.9;
  }

  .prose :global(h2) {
    margin-top: 2.4em;
    margin-bottom: 0.8em;
    font-size: 30px;
    letter-spacing: -0.05em;
  }

  .prose :global(h3) {
    margin-top: 2em;
    margin-bottom: 0.7em;
    font-size: 22px;
    letter-spacing: -0.04em;
  }

  .prose :global(p) {
    margin: 0 0 1.5em;
    color: var(--text-secondary);
  }

  .prose :global(a) {
    color: var(--black);
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
    text-underline-offset: 4px;
  }

  .prose :global(a:hover) {
    text-decoration-color: var(--black);
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 1.5em;
    padding-left: 1.5em;
    color: var(--text-secondary);
  }

  .prose :global(li) {
    margin-bottom: 0.5em;
    padding-left: 0.3em;
  }

  .prose :global(blockquote) {
    margin: 2em 0;
    padding: 5px 0 5px 24px;
    border-left: 2px solid var(--black);
    color: var(--text-secondary);
    font-size: 18px;
  }

  .prose :global(pre) {
    overflow-x: auto;
    margin: 2em 0;
    padding: 24px;
    border: 1px solid #333333;
    background: #111111;
    color: #eeeeee;
    font-size: 13px;
    line-height: 1.7;
  }

  .prose :global(code) {
    font-size: 0.9em;
  }

  .prose :global(p code),
  .prose :global(li code) {
    padding: 3px 6px;
    background: var(--surface);
    color: var(--black);
  }

  .prose :global(hr) {
    margin: 3em 0;
    border: 0;
    border-top: 1px solid var(--border);
  }

  .article-end {
    margin-top: 75px;
    padding-top: 30px;
    border-top: 1px solid var(--border);
  }

  .article-end > span {
    color: var(--text-muted);
    font-size: 20px;
  }

  .article-end p {
    margin: 12px 0 20px;
    font-size: 14px;
  }

  .article-end a {
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
  }

  @media (max-width: 720px) {
    article {
      padding-top: 60px;
    }

    .article-header {
      padding-bottom: 35px;
    }

    .article-header h1 {
      font-size: clamp(36px, 9vw, 52px);
    }

    .article-description {
      font-size: 15px;
    }

    .hero-image {
      margin-bottom: 35px;
    }

    .prose {
      font-size: 15px;
      line-height: 1.85;
    }

    .prose :global(h2) {
      font-size: 25px;
    }

    .prose :global(h3) {
      font-size: 20px;
    }

    .prose :global(pre) {
      padding: 16px;
      font-size: 12px;
    }
  }
</style>
